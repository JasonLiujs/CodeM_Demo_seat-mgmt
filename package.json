{
  "name": "seat-mgmt",
  "version": "1.0.0",
  "private": true,
  "description": "工位管理系统 — 前后端脚手架与数据库基础",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @seat-mgmt/backend\" \"npm run dev -w @seat-mgmt/frontend\"",
    "build": "npm run build -w @seat-mgmt/shared && npm run build -w @seat-mgmt/backend && npm run build -w @seat-mgmt/frontend",
    "build:backend": "npm run build -w @seat-mgmt/backend",
    "build:frontend": "npm run build -w @seat-mgmt/frontend",
    "migrate": "npm run migrate -w @seat-mgmt/backend",
    "seed": "npm run seed -w @seat-mgmt/backend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w @seat-mgmt/shared && npm run typecheck -w @seat-mgmt/backend && npm run typecheck -w @seat-mgmt/frontend",
    "test": "npm run test -w @seat-mgmt/backend && npm run test -w @seat-mgmt/frontend"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/multer": "^1.4.13",
    "multer": "^1.4.5-lts.2"
  }
}
